# NYC 311 public dataset
NYC311_BASE_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json

# Open-Meteo Historical Weather API
WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Inclusive date range: YYYY-MM-DD
# NYC 311 is updated daily, so the most recent days are usually incomplete.
# The verified M1 snapshot used END_DATE=2026-10-11 (the retrieval date);
# for new runs, consider ending a few days earlier.
START_DATE=2025-10-12
END_DATE=2026-10-11

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=120

# Number of NYC 311 records per page (1-50000; the script default is 1000 if unset).
# The page size is not part of the checkpoint configuration, so it may be
# changed when resuming. It only changes how records are split across raw
# files, not which records are retrieved.
# NOTE: The verified M1 snapshot was NOT downloaded with a single page size.
# Its 263 raw files hold 45 x 1,000, 26 x 5,000, 5 x 10,000 and
# 186 x 20,000 records, plus one final partial file of 8,178 records.
# See docs/M1-Report.md (Section 3) and docs/sources.md.
NYC311_PAGE_SIZE=20000

# Empty means no complaint-type filter
NYC311_COMPLAINT_TYPES=

# Optional NYC 311 recovery controls. Normally leave the cursor fields empty
# and the offset at 0 for a fresh extraction.
# - If data/raw/nyc311/.cursor_checkpoint.json exists and its date range and
#   complaint-type filter match the settings above, the checkpoint cursor
#   takes precedence over NYC311_START_CREATED_DATE / NYC311_START_UNIQUE_KEY.
# - Both cursor fields must be set together.
# - NYC311_START_OFFSET only sets the number used in raw file names
#   (..._offset_N.json); it is not sent to the API.
# - If the checkpoint already points to the end of the requested range,
#   re-running the script retrieves no new records and may save an empty
#   page file. Check data/raw/nyc311/ after such a run.
NYC311_START_CREATED_DATE=
NYC311_START_UNIQUE_KEY=
NYC311_START_OFFSET=0